  created_at       DateTime?              @db.Timestamp(0)
  updated_at       DateTime?              @db.Timestamp(0)
  products         products               @relation(fields: [product_id], references: [id], onUpdate: NoAction, map: "consignment_items_product_foreign")
  suppliers        suppliers              @relation(fields: [supplier_id], references: [id], onUpdate: NoAction, map: "consignment_items_supplier_foreign")
  payables         consignment_payables[]

  @@index([product_id, supplier_id])
  @@index([status])
  @@map("consignment_items")
}

model consignment_payables {
  id                BigInt                     @id @default(autoincrement())
  consignment_id    BigInt
  supplier_id       BigInt
  qty_sold          Int
  unit_price        Decimal                    @db.Decimal(15, 2)
  total_amount      Decimal                    @db.Decimal(15, 2)
  status            consignment_payable_status @default(pending)
  created_at        DateTime?                  @db.Timestamp(0)
  updated_at        DateTime?                  @db.Timestamp(0)
  consignment_items consignment_items          @relation(fields: [consignment_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "consignment_payables_consignment_foreign")
  suppliers         suppliers                  @relation(fields: [supplier_id], references: [id], onUpdate: NoAction, map: "consignment_payables_supplier_foreign")
  settlements       consignment_settlements[]

  @@index([supplier_id, status])
  @@map("consignment_payables")
}

model consignment_settlements {
  id                   BigInt               @id @default(autoincrement())
  payable_id           BigInt
  settlement_no        String               @unique @db.VarChar(60)
  settlement_date      DateTime             @db.Date
  amount_paid          Decimal              @db.Decimal(15, 2)
  payment_method       payment_method_type
  reference_no         String?              @db.VarChar(100)
  processed_by         BigInt
  created_at           DateTime?            @db.Timestamp(0)
  consignment_payables consignment_payables @relation(fields: [payable_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "consignment_settlements_payable_foreign")
  users                User                 @relation(fields: [processed_by], references: [id], onUpdate: NoAction, map: "consignment_settlements_user_foreign")

  @@index([payable_id])
  @@map("consignment_settlements")
}

// ============================================
// MODUL 4: KEUANGAN (ACCOUNTS PAYABLE & RECEIVABLE)
// ============================================

model accounts_payable {
  id           BigInt                     @id @default(autoincrement())
  supplier_id  BigInt
  invoice_no   String                     @unique @db.VarChar(60)
  invoice_date DateTime                   @db.Date
  due_date     DateTime                   @db.Date
  subtotal     Decimal                    @db.Decimal(15, 2)
  tax_amount   Decimal                    @default(0.00) @db.Decimal(15, 2)
  total_amount Decimal                    @db.Decimal(15, 2)
  amount_paid  Decimal                    @default(0.00) @db.Decimal(15, 2)
  amount_due   Decimal                    @db.Decimal(15, 2)
  status       ap_ar_status               @default(open)
  notes        String?                    @db.Text
  created_at   DateTime?                  @db.Timestamp(0)
  updated_at   DateTime?                  @db.Timestamp(0)
  suppliers    suppliers                  @relation(fields: [supplier_id], references: [id], onUpdate: NoAction, map: "accounts_payable_supplier_foreign")
  ap_details   accounts_payable_details[]

  @@index([supplier_id, status])
  @@index([due_date, status])
  @@map("accounts_payable")
}

model accounts_payable_details {
  id               BigInt           @id @default(autoincrement())
  ap_id            BigInt
  product_id       BigInt?
  description      String           @db.VarChar(255)
  qty              Int              @default(1)
  unit_price       Decimal          @db.Decimal(15, 2)
  line_total       Decimal          @db.Decimal(15, 2)
  created_at       DateTime?        @db.Timestamp(0)
  accounts_payable accounts_payable @relation(fields: [ap_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "ap_details_ap_foreign")
  products         products?        @relation(fields: [product_id], references: [id], onUpdate: NoAction, map: "ap_details_product_foreign")

  @@index([ap_id])
  @@map("accounts_payable_details")
}

model accounts_receivable {
  id            BigInt                        @id @default(autoincrement())
  member_id     BigInt?
  customer_name String                        @db.VarChar(150)
  invoice_no    String                        @unique @db.VarChar(60)
  invoice_date  DateTime                      @db.Date
  due_date      DateTime                      @db.Date
  subtotal      Decimal                       @db.Decimal(15, 2)
  tax_amount    Decimal                       @default(0.00) @db.Decimal(15, 2)
  total_amount  Decimal                       @db.Decimal(15, 2)
  amount_paid   Decimal                       @default(0.00) @db.Decimal(15, 2)
  amount_due    Decimal                       @db.Decimal(15, 2)
  status        ap_ar_status                  @default(open)
  credit_limit  Decimal?                      @db.Decimal(15, 2)
  notes         String?                       @db.Text
  created_at    DateTime?                     @db.Timestamp(0)
  updated_at    DateTime?                     @db.Timestamp(0)
  members       Member?                       @relation(fields: [member_id], references: [id], onUpdate: NoAction, map: "accounts_receivable_member_foreign")
  ar_details    accounts_receivable_details[]

  @@index([member_id, status])
  @@index([due_date, status])
  @@map("accounts_receivable")
}

model accounts_receivable_details {
  id                  BigInt              @id @default(autoincrement())
  ar_id               BigInt
  product_id          BigInt?
  description         String              @db.VarChar(255)
  qty                 Int                 @default(1)
  unit_price          Decimal             @db.Decimal(15, 2)
  line_total          Decimal             @db.Decimal(15, 2)
  created_at          DateTime?           @db.Timestamp(0)
  accounts_receivable accounts_receivable @relation(fields: [ar_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "ar_details_ar_foreign")
  products            products?           @relation(fields: [product_id], references: [id], onUpdate: NoAction, map: "ar_details_product_foreign")

  @@index([ar_id])
  @@map("accounts_receivable_details")
}

model tax_calculations {
  id             BigInt    @id @default(autoincrement())
  order_id       BigInt?
  invoice_id     String?   @db.VarChar(60)
  tax_type       tax_type
  tax_percentage Decimal   @db.Decimal(5, 2)
  taxable_amount Decimal   @db.Decimal(15, 2)
  tax_amount     Decimal   @db.Decimal(15, 2)
  created_at     DateTime? @db.Timestamp(0)

  @@index([order_id])
  @@map("tax_calculations")
}

// ============================================
// MODUL 5: PEMBELIAN (PROCUREMENT)
// ============================================

model suppliers {
  id                   BigInt                 @id @default(autoincrement())
  supplier_code        String                 @unique @db.VarChar(50)
  supplier_name        String                 @db.VarChar(200)
  contact_person       String?                @db.VarChar(150)
  phone                String?                @db.VarChar(20)
  email                String?                @db.VarChar(100)
  address              String?                @db.Text
  city                 String?                @db.VarChar(50)
  payment_terms        Int?                   @db.SmallInt
  avg_delivery_days    Int?                   @db.SmallInt
  is_active            Boolean                @default(true)
  notes                String?                @db.Text
  created_at           DateTime?              @db.Timestamp(0)
  updated_at           DateTime?              @db.Timestamp(0)
  purchase_orders      purchase_orders[]
  ap                   accounts_payable[]
  consignments         consignment_items[]
  consignment_payables consignment_payables[]
  good_receipts        good_receipts[]

  @@map("suppliers")
}

model purchase_orders {
  id                BigInt                 @id @default(autoincrement())
  supplier_id       BigInt
  po_no             String                 @unique @db.VarChar(60)
  po_date           DateTime               @db.Date
  expected_delivery DateTime               @db.Date
  status            po_status              @default(draft)
  subtotal          Decimal                @db.Decimal(15, 2)
  tax_amount        Decimal                @default(0.00) @db.Decimal(15, 2)
  total_amount      Decimal                @db.Decimal(15, 2)
  notes             String?                @db.Text
  created_by        BigInt
  approved_by       BigInt?
  approved_at       DateTime?              @db.Timestamp(0)
  created_at        DateTime?              @db.Timestamp(0)
  updated_at        DateTime?              @db.Timestamp(0)
  suppliers         suppliers              @relation(fields: [supplier_id], references: [id], onUpdate: NoAction, map: "purchase_orders_supplier_foreign")
  po_items          purchase_order_items[]
  good_receipts     good_receipts[]

  @@index([supplier_id, status])
  @@index([po_date])
  @@map("purchase_orders")
}

model purchase_order_items {
  id              BigInt          @id @default(autoincrement())
  po_id           BigInt
  product_id      BigInt
  qty_ordered     Int
  qty_received    Int             @default(0)
  unit_price      Decimal         @db.Decimal(15, 2)
  line_total      Decimal         @db.Decimal(15, 2)
  created_at      DateTime?       @db.Timestamp(0)
  purchase_orders purchase_orders @relation(fields: [po_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "po_items_po_foreign")
  products        products        @relation(fields: [product_id], references: [id], onUpdate: NoAction, map: "po_items_product_foreign")

  @@index([po_id])
  @@index([product_id])
  @@map("purchase_order_items")
}

model good_receipts {
  id              BigInt               @id @default(autoincrement())
  po_id           BigInt
  supplier_id     BigInt
  gr_no           String               @unique @db.VarChar(60)
  gr_date         DateTime             @db.Date
  status          gr_status            @default(received)
  received_by     BigInt
  notes           String?              @db.Text
  created_at      DateTime?            @db.Timestamp(0)
  updated_at      DateTime?            @db.Timestamp(0)
  purchase_orders purchase_orders      @relation(fields: [po_id], references: [id], onUpdate: NoAction, map: "good_receipts_po_foreign")
  suppliers       suppliers            @relation(fields: [supplier_id], references: [id], onUpdate: NoAction, map: "good_receipts_supplier_foreign")
  gr_items        good_receipt_items[]

  @@index([po_id])
  @@index([gr_date])
  @@map("good_receipts")
}

model good_receipt_items {
  id            BigInt        @id @default(autoincrement())
  gr_id         BigInt
  product_id    BigInt
  qty_received  Int
  qty_accepted  Int           @default(0)
  qty_rejected  Int           @default(0)
  notes         String?       @db.Text
  created_at    DateTime?     @db.Timestamp(0)
  good_receipts good_receipts @relation(fields: [gr_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "gr_items_gr_foreign")
  products      products      @relation(fields: [product_id], references: [id], onUpdate: NoAction, map: "gr_items_product_foreign")

  @@index([gr_id])
  @@index([product_id])
  @@map("good_receipt_items")
}

// ============================================
// MODUL 6: APPROVAL WORKFLOWS & SECURITY
// ============================================

model approval_workflows {
  id                BigInt               @id @default(autoincrement())
  workflow_code     String               @unique @db.VarChar(50)
  workflow_name     String               @db.VarChar(150)
  module_type       approval_module_type
  action_type       approval_action_type
  requires_approval Boolean              @default(true)
  approval_levels   Int                  @default(1)
  is_active         Boolean              @default(true)
  created_at        DateTime?            @db.Timestamp(0)
  updated_at        DateTime?            @db.Timestamp(0)
  approval_requests approval_requests[]

  @@map("approval_workflows")
}

model approval_requests {
  id                 BigInt             @id @default(autoincrement())
  workflow_id        BigInt
  reference_type     String             @db.VarChar(100)
  reference_id       BigInt
  requested_by       BigInt
  current_level      Int                @default(1)
  status             approval_status    @default(pending)
  rejection_reason   String?            @db.Text
  created_at         DateTime?          @db.Timestamp(0)
  updated_at         DateTime?          @db.Timestamp(0)
  approved_at        DateTime?          @db.Timestamp(0)
  approved_by        BigInt?
  approval_workflows approval_workflows @relation(fields: [workflow_id], references: [id], onUpdate: NoAction, map: "approval_requests_workflow_foreign")

  @@index([reference_type, reference_id])
  @@index([status, current_level])
  @@map("approval_requests")
}

// ============================================
// MODUL 7 & 8: CRM & LOYALTY PROGRAM
// ============================================

model loyalty_programs {
  id                BigInt                @id @default(autoincrement())
  program_code      String                @unique @db.VarChar(50)
  program_name      String                @db.VarChar(150)
  description       String?               @db.Text
  points_per_rupiah Decimal               @db.Decimal(10, 6)
  minimum_purchase  Decimal               @db.Decimal(15, 2)
  is_active         Boolean               @default(true)
  created_at        DateTime?             @db.Timestamp(0)
  updated_at        DateTime?             @db.Timestamp(0)
  memberships       loyalty_memberships[]
  redemptions       loyalty_redemptions[]

  @@map("loyalty_programs")
}

model loyalty_memberships {
  id               BigInt           @id @default(autoincrement())
  member_id        BigInt
  program_id       BigInt
  membership_level membership_level @default(bronze)
  total_points     Decimal          @default(0.00) @db.Decimal(15, 2)
  points_used      Decimal          @default(0.00) @db.Decimal(15, 2)
  points_available Decimal          @default(0.00) @db.Decimal(15, 2)
  member_since     DateTime         @db.Date
  last_activity    DateTime?        @db.Timestamp(0)
  created_at       DateTime?        @db.Timestamp(0)
  updated_at       DateTime?        @db.Timestamp(0)
  members          Member           @relation(fields: [member_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "loyalty_memberships_member_foreign")
  loyalty_programs loyalty_programs @relation(fields: [program_id], references: [id], onUpdate: NoAction, map: "loyalty_memberships_program_foreign")

  @@unique([member_id, program_id])
  @@index([member_id, membership_level])
  @@map("loyalty_memberships")
}

model loyalty_redemptions {
  id               BigInt           @id @default(autoincrement())
  membership_id    BigInt
  program_id       BigInt
  order_id         BigInt?
  points_redeemed  Decimal          @db.Decimal(15, 2)
  discount_amount  Decimal          @db.Decimal(15, 2)
  redemption_date  DateTime         @db.Timestamp(0)
  created_at       DateTime?        @db.Timestamp(0)
  loyalty_programs loyalty_programs @relation(fields: [program_id], references: [id], onUpdate: NoAction, map: "loyalty_redemptions_program_foreign")

  @@index([membership_id, redemption_date])
  @@map("loyalty_redemptions")
}

model price_tiers {
  id           BigInt          @id @default(autoincrement())
  product_id   BigInt
  tier_name    price_tier_name
  min_qty      Int             @default(1)
  price        Decimal         @db.Decimal(15, 2)
  discount_pct Decimal?        @db.Decimal(5, 2)
  is_active    Boolean         @default(true)
  created_at   DateTime?       @db.Timestamp(0)
  updated_at   DateTime?       @db.Timestamp(0)
  products     products        @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "price_tiers_product_foreign")

  @@unique([product_id, tier_name, min_qty])
  @@index([product_id, tier_name])
  @@map("price_tiers")
}

model customer_segments {
  id               BigInt    @id @default(autoincrement())
  segment_code     String    @unique @db.VarChar(50)
  segment_name     String    @db.VarChar(150)
  description      String?   @db.Text
  min_purchase_amt Decimal?  @db.Decimal(15, 2)
  max_purchase_amt Decimal?  @db.Decimal(15, 2)
  is_active        Boolean   @default(true)
  created_at       DateTime? @db.Timestamp(0)
  updated_at       DateTime? @db.Timestamp(0)

  @@map("customer_segments")
}

// ============================================
// MODUL 6: ANALYTICS & REPORTING
// ============================================

model sales_analytics {
  id                 BigInt    @id @default(autoincrement())
  date               DateTime  @db.Date
  unit_id            BigInt
  total_sales        Decimal   @db.Decimal(15, 2)
  total_transactions Int
  avg_transaction    Decimal   @db.Decimal(15, 2)
  cash_sales         Decimal   @db.Decimal(15, 2)
  credit_sales       Decimal   @db.Decimal(15, 2)
  gross_margin       Decimal   @db.Decimal(15, 2)
  created_at         DateTime? @db.Timestamp(0)

  @@unique([date, unit_id])
  @@index([date])
  @@map("sales_analytics")
}

model product_analytics {
  id              BigInt                  @id @default(autoincrement())
  product_id      BigInt
  period_date     DateTime                @db.Date
  qty_sold        Int
  revenue         Decimal                 @db.Decimal(15, 2)
  turn_ratio      Decimal                 @db.Decimal(10, 2)
  last_sold_date  DateTime?               @db.Date
  days_in_stock   Int?
  movement_status product_movement_status @default(normal)
  created_at      DateTime?               @db.Timestamp(0)
  products        products                @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "product_analytics_product_foreign")

  @@unique([product_id, period_date])
  @@index([product_id, movement_status])
  @@map("product_analytics")
}

