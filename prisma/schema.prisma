generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// FIX (28 Jul 2026): model ini sebelumnya TIDAK ADA di schema meski dipakai
// aktif oleh src/lib/actions/budgets.ts (prisma.budgets.findMany/create/createMany).
// Akibatnya /akuntansi/anggaran SELALU error (TypeError: Cannot read properties
// of undefined) untuk siapa pun yang membukanya - bug lama, ditemukan saat
// investigasi laporan error live site, tidak berkaitan dengan seeding data.
model budgets {
  id         BigInt    @id @default(autoincrement())
  code       String    @unique @db.VarChar(30)
  name       String    @db.VarChar(150)
  allocated  Decimal   @db.Decimal(15, 2)
  used       Decimal   @default(0.00) @db.Decimal(15, 2)
  color      String    @db.VarChar(50)
  year       Int
  created_at DateTime? @default(now()) @db.Timestamp()
  updated_at DateTime? @updatedAt @db.Timestamp()
}

model accounts_payable {
  id                       BigInt                     @id @default(autoincrement()) 
  supplier_id              BigInt                     
  invoice_no               String                     @unique @db.VarChar(60)
  invoice_date             DateTime                   @db.Date
  due_date                 DateTime                   @db.Date
  subtotal                 Decimal                    @db.Decimal(15, 2)
  tax_amount               Decimal                    @default(0.00) @db.Decimal(15, 2)
  total_amount             Decimal                    @db.Decimal(15, 2)
  amount_paid              Decimal                    @default(0.00) @db.Decimal(15, 2)
  amount_due               Decimal                    @db.Decimal(15, 2)
  status                   accounts_payable_status    @default(open)
  notes                    String?                    @db.Text
  created_at               DateTime?                  @db.Timestamp()
  updated_at               DateTime?                  @db.Timestamp()
  suppliers                suppliers                  @relation(fields: [supplier_id], references: [id], onUpdate: NoAction, map: "accounts_payable_supplier_foreign")
  accounts_payable_details accounts_payable_details[]

  @@index([due_date, status])
  @@index([supplier_id, status])
}

model accounts_payable_details {
  id               BigInt           @id @default(autoincrement()) 
  ap_id            BigInt           
  product_id       BigInt?          
  description      String           @db.VarChar(255)
  qty              Int              @default(1)
  unit_price       Decimal          @db.Decimal(15, 2)
  line_total       Decimal          @db.Decimal(15, 2)
  created_at       DateTime?        @db.Timestamp()
  accounts_payable accounts_payable @relation(fields: [ap_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "ap_details_ap_foreign")
  products         products?        @relation(fields: [product_id], references: [id], onUpdate: NoAction, map: "ap_details_product_foreign")

  @@index([ap_id])
  @@index([product_id])
}

model accounts_receivable {
  id                          BigInt                        @id @default(autoincrement()) 
  member_id                   BigInt?                       
  customer_name               String                        @db.VarChar(150)
  invoice_no                  String                        @unique @db.VarChar(60)
  invoice_date                DateTime                      @db.Date
  due_date                    DateTime                      @db.Date
  subtotal                    Decimal                       @db.Decimal(15, 2)
  tax_amount                  Decimal                       @default(0.00) @db.Decimal(15, 2)
  total_amount                Decimal                       @db.Decimal(15, 2)
  amount_paid                 Decimal                       @default(0.00) @db.Decimal(15, 2)
  amount_due                  Decimal                       @db.Decimal(15, 2)
  status                      accounts_receivable_status    @default(open)
  credit_limit                Decimal?                      @db.Decimal(15, 2)
  notes                       String?                       @db.Text
  created_at                  DateTime?                     @db.Timestamp()
  updated_at                  DateTime?                     @db.Timestamp()
  members                     members?                      @relation(fields: [member_id], references: [id], onUpdate: NoAction, map: "accounts_receivable_member_foreign")
  accounts_receivable_details accounts_receivable_details[]

  @@index([due_date, status])
  @@index([member_id, status])
}

model accounts_receivable_details {
  id                  BigInt              @id @default(autoincrement()) 
  ar_id               BigInt              
  product_id          BigInt?             
  description         String              @db.VarChar(255)
  qty                 Int                 @default(1)
  unit_price          Decimal             @db.Decimal(15, 2)
  line_total          Decimal             @db.Decimal(15, 2)
  created_at          DateTime?           @db.Timestamp()
  accounts_receivable accounts_receivable @relation(fields: [ar_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "ar_details_ar_foreign")
  products            products?           @relation(fields: [product_id], references: [id], onUpdate: NoAction, map: "ar_details_product_foreign")

  @@index([ar_id])
  @@index([product_id])
}

model app_settings {
  id           BigInt    @id @default(autoincrement()) 
  company_name String    @default("Koperasi Digital") @db.VarChar(150)
  address      String?   @db.Text
  phone        String?   @db.VarChar(50)
  logo_url     String?   @default("/koperasi.png") @db.VarChar(255)
  created_at   DateTime? @db.Timestamp()
  updated_at   DateTime? @db.Timestamp()
  shu_config   String?   @db.Text
  loan_rules   String?   @db.Text
}

model approval_requests {
  id                 BigInt                   @id @default(autoincrement()) 
  workflow_id        BigInt                   
  reference_type     String                   @db.VarChar(100)
  reference_id       BigInt                   
  requested_by       BigInt                   
  current_level      Int                      @default(1)
  status             approval_requests_status @default(pending)
  rejection_reason   String?                  @db.Text
  created_at         DateTime?                @db.Timestamp()
  updated_at         DateTime?                @db.Timestamp()
  approved_at        DateTime?                @db.Timestamp()
  approved_by        BigInt?                  
  approval_workflows approval_workflows       @relation(fields: [workflow_id], references: [id], onUpdate: NoAction, map: "approval_requests_workflow_foreign")

  @@index([reference_type, reference_id])
  @@index([status, current_level])
  @@index([workflow_id])
}

model approval_workflows {
  id                BigInt                         @id @default(autoincrement()) 
  workflow_code     String                         @unique @db.VarChar(50)
  workflow_name     String                         @db.VarChar(150)
  module_type       approval_workflows_module_type
  action_type       approval_workflows_action_type
  requires_approval Boolean                        @default(true)
  approval_levels   Int                            @default(1)
  is_active         Boolean                        @default(true)
  created_at        DateTime?                      @db.Timestamp()
  updated_at        DateTime?                      @db.Timestamp()
  approval_requests approval_requests[]
}

model audit_logs {
  id         BigInt   @id @default(autoincrement()) 
  user_id    BigInt?  
  action     String   @db.VarChar(50)
  model_type String?  @db.VarChar(100)
  model_id   BigInt?  
  old_values Json?
  new_values Json?
  ip_address String?  @db.VarChar(45)
  user_agent String?  @db.VarChar(255)
  url        String?  @db.VarChar(500)
  created_at DateTime @db.Timestamp()
  users      users?   @relation(fields: [user_id], references: [id], onUpdate: NoAction, map: "audit_logs_user_id_foreign")

  @@index([created_at])
  @@index([model_type, model_id])
  @@index([user_id, created_at])
}

model cache {
  key        String @id @db.VarChar(255)
  value      String @db.Text
  expiration Int
}

model cache_locks {
  key        String @id @db.VarChar(255)
  owner      String @db.VarChar(255)
  expiration Int
}

model cash_register_sessions {
  id               BigInt                        @id @default(autoincrement()) 
  cash_register_id BigInt                        
  session_date     DateTime                      @db.Date
  opened_by        BigInt                        
  closed_by        BigInt?                       
  opening_balance  Decimal                       @db.Decimal(15, 2)
  closing_balance  Decimal?                      @db.Decimal(15, 2)
  expected_balance Decimal?                      @db.Decimal(15, 2)
  difference       Decimal?                      @db.Decimal(15, 2)
  status           cash_register_sessions_status @default(open)
  notes            String?                       @db.Text
  opened_at        DateTime                      @db.Timestamp()
  closed_at        DateTime?                     @db.Timestamp()
  created_at       DateTime?                     @db.Timestamp()
  updated_at       DateTime?                     @db.Timestamp()
  cash_registers   cash_registers                @relation(fields: [cash_register_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "cash_register_sessions_cash_register_id_foreign")

  @@unique([cash_register_id, session_date])
  @@index([cash_register_id])
  @@index([session_date, status])
}

model cash_registers {
  id                     BigInt                   @id @default(autoincrement()) 
  unit_id                BigInt                   
  register_no            String                   @unique @db.VarChar(50)
  register_name          String                   @db.VarChar(100)
  location               String?                  @db.VarChar(100)
  is_active              Boolean                  @default(true)
  created_at             DateTime?                @db.Timestamp()
  updated_at             DateTime?                @db.Timestamp()
  cash_register_sessions cash_register_sessions[]
  units                  units                    @relation(fields: [unit_id], references: [id], onUpdate: NoAction, map: "cash_registers_unit_id_foreign")

  @@index([unit_id])
}

model chart_of_accounts {
  id                      BigInt                           @id @default(autoincrement()) 
  unit_id                 BigInt                           
  code                    String                           @db.VarChar(20)
  name                    String                           @db.VarChar(150)
  type                    chart_of_accounts_type
  normal_balance          chart_of_accounts_normal_balance
  parent_id               BigInt?                          
  level                   Int                              @default(1) @db.SmallInt
  is_header               Boolean                          @default(false)
  is_active               Boolean                          @default(true)
  created_at              DateTime?                        @db.Timestamp()
  updated_at              DateTime?                        @db.Timestamp()
  chart_of_accounts       chart_of_accounts?               @relation("chart_of_accountsTochart_of_accounts", fields: [parent_id], references: [id], onUpdate: NoAction, map: "chart_of_accounts_parent_id_foreign")
  other_chart_of_accounts chart_of_accounts[]              @relation("chart_of_accountsTochart_of_accounts")
  units                   units                            @relation(fields: [unit_id], references: [id], onUpdate: NoAction, map: "chart_of_accounts_unit_id_foreign")
  journal_lines           journal_lines[]

  @@unique([unit_id, code], map: "uq_unit_account_code")
  @@index([parent_id])
  @@index([unit_id, type])
}

model consignment_items {
  id                   BigInt                   @id @default(autoincrement()) 
  product_id           BigInt                   
  supplier_id          BigInt                   
  consignment_date     DateTime                 @db.Date
  qty_received         Int
  qty_sold             Int                      @default(0)
  qty_returned         Int                      @default(0)
  status               consignment_items_status @default(active)
  created_at           DateTime?                @db.Timestamp()
  updated_at           DateTime?                @db.Timestamp()
  return_reason        String?                  @db.Text
  return_date          DateTime?                @db.Timestamp
  products             products                 @relation(fields: [product_id], references: [id], onUpdate: NoAction, map: "consignment_items_product_foreign")
  suppliers            suppliers                @relation(fields: [supplier_id], references: [id], onUpdate: NoAction, map: "consignment_items_supplier_foreign")
  consignment_payables consignment_payables[]

  @@index([product_id, supplier_id])
  @@index([status])
  @@index([supplier_id])
}

model consignment_payables {
  id                      BigInt                      @id @default(autoincrement()) 
  consignment_id          BigInt                      
  supplier_id             BigInt                      
  qty_sold                Int
  unit_price              Decimal                     @db.Decimal(15, 2)
  total_amount            Decimal                     @db.Decimal(15, 2)
  status                  consignment_payables_status @default(pending)
  created_at              DateTime?                   @db.Timestamp()
  updated_at              DateTime?                   @db.Timestamp()
  consignment_items       consignment_items           @relation(fields: [consignment_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "consignment_payables_consignment_foreign")
  suppliers               suppliers                   @relation(fields: [supplier_id], references: [id], onUpdate: NoAction, map: "consignment_payables_supplier_foreign")
  consignment_settlements consignment_settlements[]

  @@index([consignment_id])
  @@index([supplier_id, status])
}

model consignment_settlements {
  id                   BigInt                                 @id @default(autoincrement()) 
  payable_id           BigInt                                 
  settlement_no        String                                 @unique @db.VarChar(60)
  settlement_date      DateTime                               @db.Date
  amount_paid          Decimal                                @db.Decimal(15, 2)
  payment_method       consignment_settlements_payment_method
  reference_no         String?                                @db.VarChar(100)
  processed_by         BigInt                                 
  created_at           DateTime?                              @db.Timestamp()
  consignment_payables consignment_payables                   @relation(fields: [payable_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "consignment_settlements_payable_foreign")
  users                users                                  @relation(fields: [processed_by], references: [id], onUpdate: NoAction, map: "consignment_settlements_user_foreign")

  @@index([payable_id])
  @@index([processed_by])
}

model customer_segments {
  id               BigInt    @id @default(autoincrement()) 
  segment_code     String    @unique @db.VarChar(50)
  segment_name     String    @db.VarChar(150)
  description      String?   @db.Text
  min_purchase_amt Decimal?  @db.Decimal(15, 2)
  max_purchase_amt Decimal?  @db.Decimal(15, 2)
  is_active        Boolean   @default(true)
  created_at       DateTime? @db.Timestamp()
  updated_at       DateTime? @db.Timestamp()
}

model failed_jobs {
  id         BigInt   @id @default(autoincrement()) 
  uuid       String   @unique(map: "failed_jobs_uuid_unique") @db.VarChar(255)
  connection String   @db.Text
  queue      String   @db.Text
  payload    String   @db.Text
  exception  String   @db.Text
  failed_at  DateTime @default(now()) @db.Timestamp()
}

model good_receipt_items {
  id            BigInt        @id @default(autoincrement()) 
  gr_id         BigInt        
  product_id    BigInt        
  qty_received  Int
  qty_accepted  Int           @default(0)
  qty_rejected  Int           @default(0)
  notes         String?       @db.Text
  created_at    DateTime?     @db.Timestamp()
  good_receipts good_receipts @relation(fields: [gr_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "gr_items_gr_foreign")
  products      products      @relation(fields: [product_id], references: [id], onUpdate: NoAction, map: "gr_items_product_foreign")

  @@index([gr_id])
  @@index([product_id])
}

model good_receipts {
  id                 BigInt               @id @default(autoincrement()) 
  po_id              BigInt               
  supplier_id        BigInt               
  gr_no              String               @unique @db.VarChar(60)
  gr_date            DateTime             @db.Date
  status             good_receipts_status @default(received)
  received_by        BigInt               
  notes              String?              @db.Text
  created_at         DateTime?            @db.Timestamp()
  updated_at         DateTime?            @db.Timestamp()
  good_receipt_items good_receipt_items[]
  purchase_orders    purchase_orders      @relation(fields: [po_id], references: [id], onUpdate: NoAction, map: "good_receipts_po_foreign")
  suppliers          suppliers            @relation(fields: [supplier_id], references: [id], onUpdate: NoAction, map: "good_receipts_supplier_foreign")

  @@index([gr_date])
  @@index([po_id])
  @@index([supplier_id])
}

model job_batches {
  id             String  @id @db.VarChar(255)
  name           String  @db.VarChar(255)
  total_jobs     Int
  pending_jobs   Int
  failed_jobs    Int
  failed_job_ids String  @db.Text
  options        String? @db.Text
  cancelled_at   Int?
  created_at     Int
  finished_at    Int?
}

model jobs {
  id           BigInt @id @default(autoincrement()) 
  queue        String @db.VarChar(255)
  payload      String @db.Text
  attempts     Int    
  reserved_at  Int?   
  available_at Int    
  created_at   Int    

  @@index([queue])
}

model journal_entries {
  id                    BigInt                 @id @default(autoincrement()) 
  unit_id               BigInt                 
  entry_no              String                 @unique(map: "journal_entries_entry_no_unique") @db.VarChar(60)
  entry_date            DateTime               @db.Date
  description           String                 @db.VarChar(255)
  reference             String?                @db.VarChar(100)
  source                journal_entries_source @default(manual)
  posted_by             BigInt?                
  posted_at             DateTime?              @db.Timestamp()
  is_posted             Boolean                @default(false)
  is_reversed           Boolean                @default(false)
  reversed_by_entry_id  BigInt?                
  created_at            DateTime?              @db.Timestamp()
  updated_at            DateTime?              @db.Timestamp()
  users                 users?                 @relation(fields: [posted_by], references: [id], onUpdate: NoAction, map: "journal_entries_posted_by_foreign")
  journal_entries       journal_entries?       @relation("journal_entriesTojournal_entries", fields: [reversed_by_entry_id], references: [id], onUpdate: NoAction, map: "journal_entries_reversed_by_entry_id_foreign")
  other_journal_entries journal_entries[]      @relation("journal_entriesTojournal_entries")
  units                 units                  @relation(fields: [unit_id], references: [id], onUpdate: NoAction, map: "journal_entries_unit_id_foreign")
  journal_lines         journal_lines[]

  @@index([posted_by])
  @@index([reversed_by_entry_id])
  @@index([unit_id, entry_date])
  @@index([unit_id, is_posted, entry_date])
}

model journal_lines {
  id                BigInt            @id @default(autoincrement()) 
  journal_id        BigInt            
  account_id        BigInt            
  debit             Decimal           @default(0.00) @db.Decimal(15, 2)
  credit            Decimal           @default(0.00) @db.Decimal(15, 2)
  description       String?           @db.VarChar(255)
  created_at        DateTime?         @db.Timestamp()
  updated_at        DateTime?         @db.Timestamp()
  chart_of_accounts chart_of_accounts @relation(fields: [account_id], references: [id], onUpdate: NoAction, map: "journal_lines_account_id_foreign")
  journal_entries   journal_entries   @relation(fields: [journal_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "journal_lines_journal_id_foreign")

  @@index([account_id])
  @@index([journal_id])
}

model loan_applications {
  id                                         BigInt                             @id @default(autoincrement()) 
  member_id                                  BigInt                             
  loan_product_id                            BigInt                             
  application_no                             String                             @unique(map: "loan_applications_application_no_unique") @db.VarChar(60)
  amount_requested                           Decimal                            @db.Decimal(15, 2)
  tenor_months                               Int                                @db.SmallInt
  repayment_method                           loan_applications_repayment_method @default(cash)
  purpose                                    String                             @db.Text
  status                                     loan_applications_status           @default(draft)
  submitted_at                               DateTime?                          @db.Timestamp()
  reviewed_by                                BigInt?                            
  reviewed_at                                DateTime?                          @db.Timestamp()
  approved_by                                BigInt?                            
  approved_at                                DateTime?                          @db.Timestamp()
  rejection_note                             String?                            @db.Text
  guarantor_name                             String?                            @db.VarChar(150)
  guarantor_phone                            String?                            @db.VarChar(20)
  created_at                                 DateTime?                          @db.Timestamp()
  updated_at                                 DateTime?                          @db.Timestamp()
  users_loan_applications_approved_byTousers users?                             @relation("loan_applications_approved_byTousers", fields: [approved_by], references: [id], onUpdate: NoAction, map: "loan_applications_approved_by_foreign")
  loan_products                              loan_products                      @relation(fields: [loan_product_id], references: [id], onUpdate: NoAction, map: "loan_applications_loan_product_id_foreign")
  members                                    members                            @relation(fields: [member_id], references: [id], onUpdate: NoAction, map: "loan_applications_member_id_foreign")
  users_loan_applications_reviewed_byTousers users?                             @relation("loan_applications_reviewed_byTousers", fields: [reviewed_by], references: [id], onUpdate: NoAction, map: "loan_applications_reviewed_by_foreign")
  loans                                      loans?

  @@index([approved_by])
  @@index([loan_product_id])
  @@index([member_id, status])
  @@index([reviewed_by])
}

model loan_payments {
  id                BigInt                       @id @default(autoincrement()) 
  loan_id           BigInt                       
  schedule_id       BigInt?                      
  payment_no        String                       @unique(map: "loan_payments_payment_no_unique") @db.VarChar(60)
  amount_paid       Decimal                      @db.Decimal(15, 2)
  principal_portion Decimal                      @db.Decimal(15, 2)
  interest_portion  Decimal                      @db.Decimal(15, 2)
  penalty_amount    Decimal                      @default(0.00) @db.Decimal(15, 2)
  payment_method    loan_payments_payment_method
  reference         String?                      @db.VarChar(100)
  processed_by      BigInt?                      
  paid_at           DateTime                     @db.Timestamp()
  note              String?                      @db.Text
  created_at        DateTime?                    @db.Timestamp()
  updated_at        DateTime?                    @db.Timestamp()
  loans             loans                        @relation(fields: [loan_id], references: [id], onUpdate: NoAction, map: "loan_payments_loan_id_foreign")
  users             users?                       @relation(fields: [processed_by], references: [id], onUpdate: NoAction, map: "loan_payments_processed_by_foreign")
  loan_schedules    loan_schedules?              @relation(fields: [schedule_id], references: [id], onUpdate: NoAction, map: "loan_payments_schedule_id_foreign")

  @@index([loan_id, paid_at])
  @@index([processed_by])
  @@index([schedule_id])
}

model loan_products {
  id                 BigInt                        @id @default(autoincrement()) 
  code               String                        @unique(map: "loan_products_code_unique") @db.VarChar(20)
  name               String                        @db.VarChar(100)
  interest_rate      Decimal                       @db.Decimal(5, 2)
  interest_method    loan_products_interest_method @default(flat)
  max_tenor          Int                           @db.SmallInt
  max_amount         Decimal                       @db.Decimal(15, 2)
  min_amount         Decimal                       @default(500000.00) @db.Decimal(15, 2)
  admin_fee_pct      Decimal                       @default(0.00) @db.Decimal(5, 2)
  penalty_pct        Decimal                       @default(0.00) @db.Decimal(5, 2)
  requires_guarantor Boolean                       @default(false)
  requirements       String?                       @db.Text
  is_active          Boolean                       @default(true)
  created_at         DateTime?                     @db.Timestamp()
  updated_at         DateTime?                     @db.Timestamp()
  description        String?                       @db.Text
  loan_applications  loan_applications[]
}

model loan_schedules {
  id             BigInt                @id @default(autoincrement()) 
  loan_id        BigInt                
  installment_no Int                   @db.SmallInt
  due_date       DateTime              @db.Date
  principal_due  Decimal               @db.Decimal(15, 2)
  interest_due   Decimal               @db.Decimal(15, 2)
  total_due      Decimal               @db.Decimal(15, 2)
  principal_paid Decimal               @default(0.00) @db.Decimal(15, 2)
  interest_paid  Decimal               @default(0.00) @db.Decimal(15, 2)
  penalty_paid   Decimal               @default(0.00) @db.Decimal(15, 2)
  paid_at        DateTime?             @db.Timestamp()
  status         loan_schedules_status @default(pending)
  created_at     DateTime?             @db.Timestamp()
  updated_at     DateTime?             @db.Timestamp()
  loan_payments  loan_payments[]
  loans          loans                 @relation(fields: [loan_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "loan_schedules_loan_id_foreign")

  @@unique([loan_id, installment_no], map: "uq_loan_installment")
  @@index([due_date, status])
  @@index([loan_id, due_date, status])
}

model loans {
  id                    BigInt                 @id @default(autoincrement()) 
  application_id        BigInt                 @unique(map: "loans_application_id_unique") 
  member_id             BigInt                 
  loan_no               String                 @unique(map: "loans_loan_no_unique") @db.VarChar(60)
  principal             Decimal                @db.Decimal(15, 2)
  interest_rate         Decimal                @db.Decimal(5, 2)
  interest_method       loans_interest_method
  admin_fee             Decimal                @default(0.00) @db.Decimal(15, 2)
  tenor_months          Int                    @db.SmallInt
  disbursed_at          DateTime               @db.Date
  first_due_date        DateTime               @db.Date
  last_due_date         DateTime               @db.Date
  monthly_installment   Decimal                @db.Decimal(15, 2)
  outstanding_principal Decimal                @db.Decimal(15, 2)
  total_paid            Decimal                @default(0.00) @db.Decimal(15, 2)
  repayment_method      loans_repayment_method @default(cash)
  status                loans_status           @default(active)
  created_at            DateTime?              @db.Timestamp()
  updated_at            DateTime?              @db.Timestamp()
  loan_payments         loan_payments[]
  loan_schedules        loan_schedules[]
