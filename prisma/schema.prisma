generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                                                     BigInt                    @id @default(autoincrement())
  member_id                                              BigInt?                   @unique(map: "users_member_id_unique")
  username                                               String                    @unique(map: "users_username_unique") @db.VarChar(50)
  email                                                  String                    @unique(map: "users_email_unique") @db.VarChar(100)
  password                                               String                    @db.VarChar(255)
  role                                                   users_role                @default(anggota)
  is_active                                              Boolean                   @default(true)
  mfa_secret                                             String?                   @db.VarChar(100)
  mfa_enabled                                            Boolean                   @default(false)
  last_login_at                                          DateTime?                 @db.Timestamp(0)
  last_login_ip                                          String?                   @db.VarChar(45)
  remember_token                                         String?                   @db.VarChar(100)
  created_at                                             DateTime?                 @db.Timestamp(0)
  updated_at                                             DateTime?                 @db.Timestamp(0)
  deleted_at                                             DateTime?                 @db.Timestamp(0)
  audit_logs                                             AuditLog[]
  journal_entries                                        journal_entries[]
  loan_applications_loan_applications_approved_byTousers loan_applications[]       @relation("loan_applications_approved_byTousers")
  loan_applications_loan_applications_reviewed_byTousers loan_applications[]       @relation("loan_applications_reviewed_byTousers")
  loan_payments                                          loan_payments[]
  orders                                                 orders[]
  saving_transactions                                    saving_transactions[]
  stock_movements                                        stock_movements[]
  members                                                Member?                   @relation(fields: [member_id], references: [id], onUpdate: NoAction, map: "users_member_id_foreign")
  order_returns                                          order_returns[]
  consignment_settlements                                consignment_settlements[]

  @@index([role, is_active], map: "users_role_is_active_index")
  @@map("users")
}

model Session {
  id            String  @id @default(cuid()) @db.VarChar(255)
  user_id       BigInt?
  ip_address    String? @db.VarChar(45)
  user_agent    String? @db.Text
  payload       String
  last_activity Int

  @@index([last_activity], map: "sessions_last_activity_index")
  @@index([user_id], map: "sessions_user_id_index")
  @@map("sessions")
}

model Member {
  id                  BigInt                @id @default(autoincrement())
  member_code         String                @unique(map: "members_member_code_unique") @db.VarChar(20)
  nik                 String                @unique(map: "members_nik_unique") @db.VarChar(16)
  full_name           String                @db.VarChar(150)
  email               String?               @unique(map: "members_email_unique") @db.VarChar(100)
  phone               String?               @db.VarChar(20)
  address             String?               @db.VarChar(255)
  birth_date          DateTime?             @db.Date
  gender              members_gender?
  join_date           DateTime              @db.Date
  photo_path          String?               @db.VarChar(255)
  status              members_status        @default(active)
  unit_id             BigInt
  created_at          DateTime?             @db.Timestamp(0)
  updated_at          DateTime?             @db.Timestamp(0)
  deleted_at          DateTime?             @db.Timestamp(0)
  loan_applications   loan_applications[]
  loans               loans[]
  units               Unit                  @relation(fields: [unit_id], references: [id], onUpdate: NoAction, map: "members_unit_id_foreign")
  orders              orders[]
  ppob_transactions   ppob_transactions[]
  saving_transactions saving_transactions[]
  savings             savings[]
  shu_distributions   shu_distributions[]
  users               User?
  loyalty_memberships loyalty_memberships[]
  accounts_receivable accounts_receivable[]
  rat_attendances     RatAttendance[]

  @@index([status, unit_id], map: "members_status_unit_id_index")
  @@index([unit_id], map: "idx_members_unit_id_foreign")
  @@map("members")
}

model Unit {
  id                  BigInt                @id @default(autoincrement())
  code                String                @unique(map: "units_code_unique") @db.VarChar(20)
  name                String                @db.VarChar(150)
  type                units_type            @default(simpan_pinjam)
  parent_id           BigInt?
  address             String?               @db.VarChar(255)
  phone               String?               @db.VarChar(20)
  is_active           Boolean               @default(true)
  created_at          DateTime?             @db.Timestamp(0)
  updated_at          DateTime?             @db.Timestamp(0)
  chart_of_accounts   chart_of_accounts[]
  journal_entries     journal_entries[]
  members             Member[]
  orders              orders[]
  products            products[]
  shu_periods         shu_periods[]
  units               Unit?                 @relation("unitsTounits", fields: [parent_id], references: [id], onUpdate: NoAction, map: "units_parent_id_foreign")
  other_units         Unit[]                @relation("unitsTounits")
  cash_registers      cash_registers[]
  warehouse_locations warehouse_locations[]

  @@index([parent_id], map: "idx_units_parent_id_foreign")
  @@map("units")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  user_id    BigInt?
  action     String   @db.VarChar(50)
  model_type String?  @db.VarChar(100)
  model_id   BigInt?
  old_values Json?
  new_values Json?
  ip_address String?  @db.VarChar(45)
  user_agent String?  @db.VarChar(255)
  url        String?  @db.VarChar(500)
  created_at DateTime @db.Timestamp(0)
  users      User?    @relation(fields: [user_id], references: [id], onUpdate: NoAction, map: "audit_logs_user_id_foreign")

  @@index([created_at], map: "audit_logs_created_at_index")
  @@index([model_type, model_id], map: "audit_logs_model_type_model_id_index")
  @@index([user_id, created_at], map: "audit_logs_user_id_created_at_index")
  @@map("audit_logs")
}

model cache {
  key        String @id @db.VarChar(255)
  value      String
  expiration Int
}

model cache_locks {
  key        String @id @db.VarChar(255)
  owner      String @db.VarChar(255)
  expiration Int
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model chart_of_accounts {
  id                      BigInt                           @id @default(autoincrement())
  unit_id                 BigInt
  code                    String                           @db.VarChar(20)
  name                    String                           @db.VarChar(150)
  type                    chart_of_accounts_type
  normal_balance          chart_of_accounts_normal_balance
  parent_id               BigInt?
  level                   Int                              @default(1) @db.SmallInt
  is_header               Boolean                          @default(false)
  is_active               Boolean                          @default(true)
  created_at              DateTime?                        @db.Timestamp(0)
  updated_at              DateTime?                        @db.Timestamp(0)
  chart_of_accounts       chart_of_accounts?               @relation("chart_of_accountsTochart_of_accounts", fields: [parent_id], references: [id], onUpdate: NoAction, map: "chart_of_accounts_parent_id_foreign")
  other_chart_of_accounts chart_of_accounts[]              @relation("chart_of_accountsTochart_of_accounts")
  units                   Unit                             @relation(fields: [unit_id], references: [id], onUpdate: NoAction, map: "chart_of_accounts_unit_id_foreign")
  journal_lines           journal_lines[]

  @@unique([unit_id, code], map: "uq_unit_account_code")
  @@index([parent_id], map: "idx_chart_of_accounts_parent_id_foreign")
  @@index([unit_id, type], map: "chart_of_accounts_unit_id_type_index")
}

model failed_jobs {
  id         BigInt   @id @default(autoincrement())
  uuid       String   @unique(map: "failed_jobs_uuid_unique") @db.VarChar(255)
  connection String   @db.Text
  queue      String   @db.Text
  payload    String
  exception  String
  failed_at  DateTime @default(now()) @db.Timestamp(0)
}

model job_batches {
  id             String  @id @db.VarChar(255)
  name           String  @db.VarChar(255)
  total_jobs     Int
  pending_jobs   Int
  failed_jobs    Int
  failed_job_ids String
  options        String?
  cancelled_at   Int?
  created_at     Int
  finished_at    Int?
}

model jobs {
  id           BigInt @id @default(autoincrement())
  queue        String @db.VarChar(255)
  payload      String
  attempts     Int
  reserved_at  Int?
  available_at Int
  created_at   Int

  @@index([queue], map: "jobs_queue_index")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model journal_entries {
  id                    BigInt                 @id @default(autoincrement())
  unit_id               BigInt
  entry_no              String                 @unique(map: "journal_entries_entry_no_unique") @db.VarChar(60)
  entry_date            DateTime               @db.Date
  description           String                 @db.VarChar(255)
  reference             String?                @db.VarChar(100)
  source                journal_entries_source @default(manual)
  posted_by             BigInt?
  posted_at             DateTime?              @db.Timestamp(0)
  is_posted             Boolean                @default(false)
  is_reversed           Boolean                @default(false)
  reversed_by_entry_id  BigInt?
  created_at            DateTime?              @db.Timestamp(0)
  updated_at            DateTime?              @db.Timestamp(0)
  users                 User?                  @relation(fields: [posted_by], references: [id], onUpdate: NoAction, map: "journal_entries_posted_by_foreign")
  journal_entries       journal_entries?       @relation("journal_entriesTojournal_entries", fields: [reversed_by_entry_id], references: [id], onUpdate: NoAction, map: "journal_entries_reversed_by_entry_id_foreign")
  other_journal_entries journal_entries[]      @relation("journal_entriesTojournal_entries")
  units                 Unit                   @relation(fields: [unit_id], references: [id], onUpdate: NoAction, map: "journal_entries_unit_id_foreign")
  journal_lines         journal_lines[]

  @@index([posted_by], map: "idx_journal_entries_posted_by_foreign")
  @@index([reversed_by_entry_id], map: "idx_journal_entries_reversed_by_entry_id_foreign")
  @@index([unit_id, entry_date], map: "journal_entries_unit_id_entry_date_index")
  @@index([unit_id, is_posted, entry_date], map: "journal_entries_unit_id_is_posted_entry_date_index")
}

model journal_lines {
  id                BigInt            @id @default(autoincrement())
  journal_id        BigInt
  account_id        BigInt
  debit             Decimal           @default(0.00) @db.Decimal(15, 2)
  credit            Decimal           @default(0.00) @db.Decimal(15, 2)
  description       String?           @db.VarChar(255)
  created_at        DateTime?         @db.Timestamp(0)
  updated_at        DateTime?         @db.Timestamp(0)
  chart_of_accounts chart_of_accounts @relation(fields: [account_id], references: [id], onUpdate: NoAction, map: "journal_lines_account_id_foreign")
  journal_entries   journal_entries   @relation(fields: [journal_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "journal_lines_journal_id_foreign")

  @@index([account_id], map: "journal_lines_account_id_index")
  @@index([journal_id], map: "journal_lines_journal_id_index")
}

