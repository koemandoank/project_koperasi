  qty_available       Int                 @default(0)
  updated_at          DateTime?           @db.Timestamp()
  warehouse_locations warehouse_locations @relation(fields: [location_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "stock_balances_location_id_foreign")
  products            products            @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "stock_balances_product_id_foreign")

  @@unique([product_id, location_id])
  @@index([location_id])
  @@index([product_id])
}

model stock_movements {
  id           BigInt               @id @default(autoincrement()) 
  product_id   BigInt               
  type         stock_movements_type
  qty          Int
  stock_before Int
  stock_after  Int
  reference    String?              @db.VarChar(100)
  note         String?              @db.Text
  created_by   BigInt?              
  created_at   DateTime?            @db.Timestamp()
  updated_at   DateTime?            @db.Timestamp()
  users        users?               @relation(fields: [created_by], references: [id], onUpdate: NoAction, map: "stock_movements_created_by_foreign")
  products     products             @relation(fields: [product_id], references: [id], onUpdate: NoAction, map: "stock_movements_product_id_foreign")

  @@index([created_by])
  @@index([product_id, created_at])
}

model stock_opname {
  id                   BigInt                 @id @default(autoincrement()) 
  opname_no            String                 @unique @db.VarChar(60)
  location_id          BigInt?                
  opname_date          DateTime               @db.Date
  status               stock_opname_status    @default(draft)
  notes                String?                @db.Text
  conducted_by         BigInt                 
  approved_by          BigInt?                
  approved_at          DateTime?              @db.Timestamp()
  created_at           DateTime?              @db.Timestamp()
  updated_at           DateTime?              @db.Timestamp()
  stock_opname_details stock_opname_details[]

  @@index([opname_date, status])
}

model stock_opname_details {
  id           BigInt       @id @default(autoincrement()) 
  opname_id    BigInt       
  product_id   BigInt       
  qty_system   Int
  qty_physical Int
  variance     Int
  notes        String?      @db.Text
  created_at   DateTime?    @db.Timestamp()
  stock_opname stock_opname @relation(fields: [opname_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "stock_opname_details_opname_foreign")
  products     products     @relation(fields: [product_id], references: [id], onUpdate: NoAction, map: "stock_opname_details_product_foreign")

  @@index([opname_id])
  @@index([product_id])
}

model stock_reorder_points {
  id             BigInt    @id @default(autoincrement()) 
  product_id     BigInt    @unique 
  reorder_qty    Int
  reorder_point  Int
  lead_time_days Int       @default(7)
  is_active      Boolean   @default(true)
  created_at     DateTime? @db.Timestamp()
  updated_at     DateTime? @db.Timestamp()
  products       products  @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "stock_reorder_points_product_id_foreign")
}

model stock_transfer_items {
  id                    BigInt                @id @default(autoincrement()) 
  transfer_order_id     BigInt                
  product_id            BigInt                
  qty_requested         Int
  qty_transferred       Int                   @default(0)
  created_at            DateTime?             @db.Timestamp()
  stock_transfer_orders stock_transfer_orders @relation(fields: [transfer_order_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "stock_transfer_items_order_foreign")
  products              products              @relation(fields: [product_id], references: [id], onUpdate: NoAction, map: "stock_transfer_items_product_foreign")

  @@index([product_id])
  @@index([transfer_order_id])
}

model stock_transfer_orders {
  id                                                                              BigInt                       @id @default(autoincrement()) 
  transfer_no                                                                     String                       @unique @db.VarChar(60)
  from_location_id                                                                BigInt                       
  to_location_id                                                                  BigInt                       
  status                                                                          stock_transfer_orders_status @default(pending)
  requested_by                                                                    BigInt                       
  approved_by                                                                     BigInt?                      
  transferred_by                                                                  BigInt?                      
  approved_at                                                                     DateTime?                    @db.Timestamp()
  transferred_at                                                                  DateTime?                    @db.Timestamp()
  notes                                                                           String?                      @db.Text
  created_at                                                                      DateTime?                    @db.Timestamp()
  updated_at                                                                      DateTime?                    @db.Timestamp()
  stock_transfer_items                                                            stock_transfer_items[]
  warehouse_locations_stock_transfer_orders_from_location_idTowarehouse_locations warehouse_locations          @relation("stock_transfer_orders_from_location_idTowarehouse_locations", fields: [from_location_id], references: [id], onUpdate: NoAction, map: "stock_transfer_from_location_foreign")
  warehouse_locations_stock_transfer_orders_to_location_idTowarehouse_locations   warehouse_locations          @relation("stock_transfer_orders_to_location_idTowarehouse_locations", fields: [to_location_id], references: [id], onUpdate: NoAction, map: "stock_transfer_to_location_foreign")

  @@index([from_location_id])
  @@index([status])
  @@index([to_location_id])
}

model suppliers {
  id                   BigInt                 @id @default(autoincrement()) 
  supplier_code        String                 @unique @db.VarChar(50)
  supplier_name        String                 @db.VarChar(200)
  contact_person       String?                @db.VarChar(150)
  phone                String?                @db.VarChar(20)
  email                String?                @db.VarChar(100)
  address              String?                @db.Text
  city                 String?                @db.VarChar(50)
  payment_terms        Int?                   @db.SmallInt
  avg_delivery_days    Int?                   @db.SmallInt
  is_active            Boolean                @default(true)
  notes                String?                @db.Text
  created_at           DateTime?              @db.Timestamp()
  updated_at           DateTime?              @db.Timestamp()
  accounts_payable     accounts_payable[]
  consignment_items    consignment_items[]
  consignment_payables consignment_payables[]
  good_receipts        good_receipts[]
  purchase_orders      purchase_orders[]
}

model tax_calculations {
  id             BigInt                    @id @default(autoincrement()) 
  order_id       BigInt?                   
  invoice_id     String?                   @db.VarChar(60)
  tax_type       tax_calculations_tax_type
  tax_percentage Decimal                   @db.Decimal(5, 2)
  taxable_amount Decimal                   @db.Decimal(15, 2)
  tax_amount     Decimal                   @db.Decimal(15, 2)
  created_at     DateTime?                 @db.Timestamp()

  @@index([order_id])
}

model units {
  id                  BigInt                @id @default(autoincrement()) 
  code                String                @unique(map: "units_code_unique") @db.VarChar(20)
  name                String                @db.VarChar(150)
  type                units_type            @default(simpan_pinjam)
  parent_id           BigInt?               
  address             String?               @db.VarChar(255)
  phone               String?               @db.VarChar(20)
  is_active           Boolean               @default(true)
  created_at          DateTime?             @db.Timestamp()
  updated_at          DateTime?             @db.Timestamp()
  cash_registers      cash_registers[]
  chart_of_accounts   chart_of_accounts[]
  journal_entries     journal_entries[]
  members             members[]
  orders              orders[]
  products            products[]
  shu_periods         shu_periods[]
  units               units?                @relation("unitsTounits", fields: [parent_id], references: [id], onUpdate: NoAction, map: "units_parent_id_foreign")
  other_units         units[]               @relation("unitsTounits")
  warehouse_locations warehouse_locations[]

  @@index([parent_id])
}

model users {
  id                                                     BigInt                    @id @default(autoincrement()) 
  member_id                                              BigInt?                   @unique(map: "users_member_id_unique") 
  username                                               String                    @unique(map: "users_username_unique") @db.VarChar(50)
  email                                                  String                    @unique(map: "users_email_unique") @db.VarChar(100)
  password                                               String                    @db.VarChar(255)
  role                                                   users_role                @default(anggota)
  is_active                                              Boolean                   @default(true)
  mfa_secret                                             String?                   @db.VarChar(100)
  mfa_enabled                                            Boolean                   @default(false)
  last_login_at                                          DateTime?                 @db.Timestamp()
  last_login_ip                                          String?                   @db.VarChar(45)
  remember_token                                         String?                   @db.VarChar(100)
  created_at                                             DateTime?                 @db.Timestamp()
  updated_at                                             DateTime?                 @db.Timestamp()
  deleted_at                                             DateTime?                 @db.Timestamp()
  audit_logs                                             audit_logs[]
  consignment_settlements                                consignment_settlements[]
  journal_entries                                        journal_entries[]
  loan_applications_loan_applications_approved_byTousers loan_applications[]       @relation("loan_applications_approved_byTousers")
  loan_applications_loan_applications_reviewed_byTousers loan_applications[]       @relation("loan_applications_reviewed_byTousers")
  loan_payments                                          loan_payments[]
  order_returns                                          order_returns[]
  orders                                                 orders[]
  saving_transactions                                    saving_transactions[]
  stock_movements                                        stock_movements[]
  members                                                members?                  @relation(fields: [member_id], references: [id], onUpdate: NoAction, map: "users_member_id_foreign")

  @@index([role, is_active])
}

model warehouse_locations {
  id                                                                                BigInt                            @id @default(autoincrement()) 
  unit_id                                                                           BigInt                            
  location_code                                                                     String                            @unique @db.VarChar(50)
  location_name                                                                     String                            @db.VarChar(150)
  location_type                                                                     warehouse_locations_location_type @default(main)
  address                                                                           String?                           @db.Text
  is_active                                                                         Boolean                           @default(true)
  created_at                                                                        DateTime?                         @db.Timestamp()
  updated_at                                                                        DateTime?                         @db.Timestamp()
  stock_balances                                                                    stock_balances[]
  stock_transfer_orders_stock_transfer_orders_from_location_idTowarehouse_locations stock_transfer_orders[]           @relation("stock_transfer_orders_from_location_idTowarehouse_locations")
  stock_transfer_orders_stock_transfer_orders_to_location_idTowarehouse_locations   stock_transfer_orders[]           @relation("stock_transfer_orders_to_location_idTowarehouse_locations")
  units                                                                             units                             @relation(fields: [unit_id], references: [id], onUpdate: NoAction, map: "warehouse_locations_unit_id_foreign")

  @@index([unit_id])
}

