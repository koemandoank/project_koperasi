model budgets {
  id         BigInt    @id @default(autoincrement())
  code       String    @unique(map: "budgets_code_unique") @db.VarChar(50)
  name       String    @db.VarChar(150)
  allocated  Decimal   @db.Decimal(15, 2)
  used       Decimal   @default(0.00) @db.Decimal(15, 2)
  color      String    @default("bg-indigo-600") @db.VarChar(50)
  year       Int       @default(2026)
  created_at DateTime? @default(now()) @db.Timestamp(0)
  updated_at DateTime? @default(now()) @db.Timestamp(0)

  @@map("budgets")
}

model Promotion {
  id          BigInt    @id @default(autoincrement())
  title       String    @db.VarChar(255)
  description String?   @db.Text
  image_url   String    @db.VarChar(255)
  link_url    String?   @db.VarChar(255)
  is_active   Boolean   @default(true)
  sort_order  Int       @default(0)
  created_at  DateTime? @db.Timestamp(0)
  updated_at  DateTime? @db.Timestamp(0)

  @@map("promotions")
}

model RatAttendance {
  id          BigInt    @id @default(autoincrement())
  member_id   BigInt
  year        Int
  is_present  Boolean   @default(true)
  voted       Boolean   @default(false)
  attended_at DateTime  @default(now()) @db.Timestamp(0)
  created_at  DateTime? @default(now()) @db.Timestamp(0)
  updated_at  DateTime? @default(now()) @db.Timestamp(0) @updatedAt
  member      Member    @relation(fields: [member_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "rat_attendance_member_id_foreign")

  @@unique([member_id, year], map: "uq_member_year_rat")
  @@index([year], map: "rat_attendance_year_index")
  @@map("rat_attendances")
}

